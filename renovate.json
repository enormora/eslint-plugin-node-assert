{
    "extends": [
        "config:base"
    ],
    "labels": [
        "renovate",
        "upgrade"
    ],
    "dependencyDashboard": false,
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true
    },
    "nvm": {
        "enabled": false
    },
    "packageRules": [
        {
            "matchPackagePatterns": [
                "^@enormora/eslint-config"
            ],
            "groupName": "@enormora/eslint-config",
            "groupSlug": "enormora-eslint-config"
        },
        {
            "matchPackagePatterns": [
                "^@packtory/"
            ],
            "groupName": "@packtory dependencies",
            "groupSlug": "packtory"
        },
        {
            "matchDepTypes": [
                "dependencies",
                "devDependencies"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr"
        }
    ],
    "platformAutomerge": true,
    "automergeStrategy": "merge-commit"
}
